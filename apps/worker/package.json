{
  "name": "@drivenx/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Scheduled jobs for DrivenX \u2014 expiry scans, and later instalment generation",
  "scripts": {
    "expiry-scan": "tsx src/index.ts expiry-scan",
    "typecheck": "tsc --noEmit",
    "contracts-daily": "tsx src/index.ts contracts-daily",
    "maintenance-due": "tsx src/index.ts maintenance-due",
    "deliver-notifications": "tsx src/index.ts deliver-notifications"
  },
  "dependencies": {
    "@drivenx/auth": "workspace:*",
    "@drivenx/core": "workspace:*",
    "@drivenx/db": "workspace:*",
    "@drivenx/logger": "workspace:*",
    "@drivenx/notify": "workspace:*"
  },
  "devDependencies": {
    "tsx": "^4.20.6",
    "typescript": "catalog:"
  }
}
