# Copy to .env on the server (beside docker-compose.prod.yml) and fill in every line.
# This file is the template; the real one is gitignored and must never be committed.
#
# Generate each secret on the server, not in a chat or an email:
#   openssl rand -hex 24      <- URL-safe, which POSTGRES_PASSWORD needs to be

# --- Where the site lives ----------------------------------------------------
# A domain whose DNS already points at this server. Caddy requests the certificate for
# it on first start, and fails if it cannot reach the server on port 80.
APP_DOMAIN=app.example.com
APP_URL=https://app.example.com

# --- Secrets -----------------------------------------------------------------
POSTGRES_PASSWORD=
# Signs the session cookie. Changing it signs everybody out.
AUTH_SECRET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=drivenx-documents

# --- First Super Admin (used once, by the seed) ------------------------------
# The seed refuses to run in production without a password, and refuses one that does
# not meet the application's own policy (12+ characters, upper, lower, digit).
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# --- Email (optional until a mailbox exists) ---------------------------------
# Unset, alerts are written to the log instead of sent. See docs/deployment.md.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# --- Housekeeping ------------------------------------------------------------
LOG_LEVEL=info
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCKOUT_MINUTES=15
S3_MAX_UPLOAD_BYTES=10485760
