# Copy to .env and fill in. Never commit .env — SOW §20 requires the client to own all credentials.

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://drivenx:drivenx_dev@localhost:5433/drivenx?schema=public"
TEST_DATABASE_URL="postgresql://drivenx:drivenx_dev@localhost:5433/drivenx_test?schema=public"

# ---------------------------------------------------------------------------
# Auth
# ---------------------------------------------------------------------------
# Generate with: openssl rand -base64 32
AUTH_SECRET="change-me-before-any-deployment"

# Account lockout policy (P0-06)
AUTH_MAX_FAILED_ATTEMPTS="5"
AUTH_LOCKOUT_MINUTES="15"

# ---------------------------------------------------------------------------
# Document storage — S3-compatible (RustFS locally, any S3 provider in production)
# ---------------------------------------------------------------------------
S3_ENDPOINT="http://localhost:9000"
S3_REGION="me-central-1"
S3_BUCKET="drivenx-documents"
S3_ACCESS_KEY_ID="drivenx"
S3_SECRET_ACCESS_KEY="drivenx_dev_secret"
S3_FORCE_PATH_STYLE="true"
S3_MAX_UPLOAD_BYTES="10485760"

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
NODE_ENV="development"
LOG_LEVEL="debug"
TZ="Asia/Dubai"

# --- Notification delivery (P3-01, P3-02) ------------------------------------
# Email goes out over SMTP so that changing provider is a change of these values
# rather than a change of code. Leave SMTP_HOST or SMTP_FROM unset and the system
# writes what it would have sent to the log instead — loudly, so an unconfigured
# install cannot be mistaken for a working one.
SMTP_HOST=
SMTP_PORT=587
# true for implicit TLS (port 465); 587 upgrades with STARTTLS on its own.
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="DrivenX <alerts@example.com>"
# Where the links in an email should point.
APP_URL=http://localhost:3000
