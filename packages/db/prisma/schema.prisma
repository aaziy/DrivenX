// DrivenX database schema
//
// Phase 0 scope: identity, configurable RBAC, and the audit log.
// Domain models arrive with their milestones — parties and documents in 1A, fleet in
// 1B, contracts/payments/ledger in 1D. The full target shape is in
// IMPLEMENTATION_PLAN.md §10.
//
// Conventions (P0-04):
//   * cuid() primary keys — non-sequential, safe to expose in URLs
//   * every table carries createdAt / updatedAt; business entities also carry
//     createdById and deletedAt (soft delete)
//   * money is BigInt fils, never Decimal or Float — see packages/core/src/money
//   * enums are database enums, so illegal states are unrepresentable
//   * snake_case table names via @@map, camelCase in the client

generator client {
  provider = "prisma-client-js"
  // Explicit output path — with pnpm's strict node_modules layout, the default
  // location resolves unpredictably across workspace packages.
  output   = "../generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Identity
// ---------------------------------------------------------------------------

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String    @map("password_hash")
  fullName     String    @map("full_name")
  phone        String?
  isActive     Boolean   @default(true) @map("is_active")

  // Lockout policy (P0-06)
  lastLoginAt  DateTime? @map("last_login_at")
  failedLogins Int       @default(0) @map("failed_logins")
  lockedUntil  DateTime? @map("locked_until")

  passwordChangedAt DateTime @default(now()) @map("password_changed_at")

  roles     UserRole[]
  auditLogs AuditLog[]

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([isActive])
  @@map("users")
}

// ---------------------------------------------------------------------------
// RBAC — permissions are data, not code (SOW §2: configurable by the Super Admin)
// ---------------------------------------------------------------------------

model Role {
  id          String  @id @default(cuid())
  key         String  @unique // super_admin, admin, sales, finance, operations
  name        String
  description String?

  /// Seeded defaults. Still fully editable — §2 requires the Super Admin to be able
  /// to reconfigure any role's permissions. This flag only protects the row from
  /// deletion, not its permission set.
  isSystem Boolean @default(false) @map("is_system")

  permissions RolePermission[]
  users       UserRole[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("roles")
}

model Permission {
  id          String  @id @default(cuid())
  key         String  @unique // "contract.approve", "payment.waive"
  group       String // UI grouping: "Contracts", "Payments"
  description String?

  roles RolePermission[]

  createdAt DateTime @default(now()) @map("created_at")

  @@index([group])
  @@map("permissions")
}

model RolePermission {
  roleId       String @map("role_id")
  permissionId String @map("permission_id")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  grantedAt DateTime @default(now()) @map("granted_at")

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model UserRole {
  userId String @map("user_id")
  roleId String @map("role_id")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  assignedAt DateTime @default(now()) @map("assigned_at")

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

// ---------------------------------------------------------------------------
// Audit log (SOW §17) — who changed what, when
// ---------------------------------------------------------------------------

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  TRANSITION
  LOGIN
  LOGIN_FAILED
  LOGOUT
  PERMISSION_CHANGE

  @@map("audit_action")
}

model AuditLog {
  id String @id @default(cuid())

  /// Null for system/job-originated changes (nightly expiry scans, schedulers).
  actorId String? @map("actor_id")
  actor   User?   @relation(fields: [actorId], references: [id], onDelete: SetNull)

  entityType String      @map("entity_type")
  entityId   String      @map("entity_id")
  action     AuditAction

  /// Field-level diff. Null on CREATE (no before) and DELETE (no after).
  before Json?
  after  Json?

  ipAddress String? @map("ip_address")
  userAgent String? @map("user_agent")
  requestId String? @map("request_id")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([entityType, entityId])
  @@index([actorId, createdAt])
  @@index([createdAt])
  @@map("audit_logs")
}
