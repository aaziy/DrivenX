// DrivenX database schema
//
// Phase 0 scope: identity, configurable RBAC, and the audit log.
// Domain models arrive with their milestones — parties and documents in 1A, fleet in
// 1B, contracts/payments/ledger in 1D. The full target shape is in
// IMPLEMENTATION_PLAN.md §10.
//
// Conventions (P0-04):
//   * cuid() primary keys — non-sequential, safe to expose in URLs
//   * every table carries createdAt / updatedAt; business entities also carry
//     createdById and deletedAt (soft delete)
//   * money is BigInt fils, never Decimal or Float — see packages/core/src/money
//   * enums are database enums, so illegal states are unrepresentable
//   * snake_case table names via @@map, camelCase in the client

generator client {
  provider = "prisma-client-js"
  // Explicit output path — with pnpm's strict node_modules layout, the default
  // location resolves unpredictably across workspace packages.
  output   = "../generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Identity
// ---------------------------------------------------------------------------

/// Interface language. Stored on the account so the choice follows the person to any
/// device; a cookie covers the sign-in page, before anyone is identified.
enum Locale {
  en
  ar

  @@map("locale")
}

model User {
  id           String  @id @default(cuid())
  email        String  @unique
  passwordHash String  @map("password_hash")
  fullName     String  @map("full_name")
  phone        String?
  isActive     Boolean @default(true) @map("is_active")

  // Lockout policy (P0-06)
  lastLoginAt  DateTime? @map("last_login_at")
  failedLogins Int       @default(0) @map("failed_logins")
  lockedUntil  DateTime? @map("locked_until")

  passwordChangedAt DateTime @default(now()) @map("password_changed_at")

  /// Interface language: English, or Arabic with a right-to-left layout.
  locale Locale @default(en)

  roles     UserRole[]
  auditLogs AuditLog[]

  createdCustomers  Customer[]
  createdSuppliers  Supplier[]
  uploadedDocuments Document[]
  notifications     Notification[]

  createdVehicles      Vehicle[]
  vehicleStatusChanges VehicleStatusChange[]
  mileageReadings      MileageReading[]

  createdContracts      Contract[]             @relation("ContractCreatedBy")
  soldContracts         Contract[]             @relation("ContractSalesperson")
  createdLeads          Lead[]                 @relation("LeadCreatedBy")
  assignedLeads         Lead[]                 @relation("LeadSalesperson")
  leadStatusChanges     LeadStatusChange[]
  leadQuotes            LeadQuote[]
  insurancePolicies     InsurancePolicy[]
  maintenanceRecords    MaintenanceRecord[]
  handovers             Handover[]
  damagePoints          DamagePoint[]
  settlementsOpened     Settlement[]           @relation("SettlementOpenedBy")
  settlementsSettled    Settlement[]           @relation("SettlementSettledBy")
  settlementLines       SettlementLine[]
  contractStatusChanges ContractStatusChange[]
  recordedPayments      Payment[]
  supplierPayments      SupplierPayment[]
  waivedInstallments    Installment[]

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([isActive])
  @@map("users")
}

// ---------------------------------------------------------------------------
// RBAC — permissions are data, not code (SOW §2: configurable by the Super Admin)
// ---------------------------------------------------------------------------

model Role {
  id          String  @id @default(cuid())
  key         String  @unique // super_admin, admin, sales, finance, operations
  name        String
  description String?

  /// Seeded defaults. Still fully editable — §2 requires the Super Admin to be able
  /// to reconfigure any role's permissions. This flag only protects the row from
  /// deletion, not its permission set.
  isSystem Boolean @default(false) @map("is_system")

  permissions RolePermission[]
  users       UserRole[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("roles")
}

model Permission {
  id          String  @id @default(cuid())
  key         String  @unique // "contract.approve", "payment.waive"
  group       String // UI grouping: "Contracts", "Payments"
  description String?

  roles RolePermission[]

  createdAt DateTime @default(now()) @map("created_at")

  @@index([group])
  @@map("permissions")
}

model RolePermission {
  roleId       String @map("role_id")
  permissionId String @map("permission_id")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  grantedAt DateTime @default(now()) @map("granted_at")

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model UserRole {
  userId String @map("user_id")
  roleId String @map("role_id")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  assignedAt DateTime @default(now()) @map("assigned_at")

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

// ---------------------------------------------------------------------------
// Audit log (SOW §17) — who changed what, when
// ---------------------------------------------------------------------------

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  TRANSITION
  LOGIN
  LOGIN_FAILED
  LOGOUT
  PERMISSION_CHANGE

  @@map("audit_action")
}

model AuditLog {
  id String @id @default(cuid())

  /// Null for system/job-originated changes (nightly expiry scans, schedulers).
  actorId String? @map("actor_id")
  actor   User?   @relation(fields: [actorId], references: [id], onDelete: SetNull)

  entityType String      @map("entity_type")
  entityId   String      @map("entity_id")
  action     AuditAction

  /// Field-level diff. Null on CREATE (no before) and DELETE (no after).
  before Json?
  after  Json?

  ipAddress String? @map("ip_address")
  userAgent String? @map("user_agent")
  requestId String? @map("request_id")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([entityType, entityId])
  @@index([actorId, createdAt])
  @@index([createdAt])
  @@map("audit_logs")
}

// ---------------------------------------------------------------------------
// Parties (SOW §5, §6) — milestone 1A
// ---------------------------------------------------------------------------

enum PartyStatus {
  ACTIVE
  INACTIVE
  BLACKLISTED

  @@map("party_status")
}

model Customer {
  id     String      @id @default(cuid())
  /// Human-facing customer number, shown on contracts and searched on (§16).
  code   String      @unique
  status PartyStatus @default(ACTIVE)

  fullName    String    @map("full_name")
  mobile      String
  email       String?
  dateOfBirth DateTime? @map("date_of_birth")
  nationality String?
  addressLine String?   @map("address_line")
  city        String?

  emergencyName  String? @map("emergency_name")
  emergencyPhone String? @map("emergency_phone")
  notes          String?

  createdById String? @map("created_by_id")
  createdBy   User?   @relation(fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  contracts Contract[]
  payments  Payment[]
  leads     Lead[]

  // Global search (§16) hits name and mobile constantly. A trigram index for
  // partial matches arrives with P1A-09, as raw SQL Prisma cannot express.
  @@index([mobile])
  @@index([fullName])
  @@index([status])
  @@map("customers")
}

model Supplier {
  id     String      @id @default(cuid())
  code   String      @unique
  status PartyStatus @default(ACTIVE)

  companyName   String  @map("company_name")
  contactPerson String? @map("contact_person")
  phone         String?
  email         String?
  address       String?

  tradeLicenseNo String? @map("trade_license_no")
  /// Tax registration number. The supplier's own, not DrivenX's.
  trn            String?

  bankName        String? @map("bank_name")
  bankAccountName String? @map("bank_account_name")
  iban            String?
  notes           String?

  createdById String? @map("created_by_id")
  createdBy   User?   @relation(fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  vehicles  Vehicle[]
  contracts Contract[]
  invoices  SupplierInvoice[]
  payments  SupplierPayment[]

  @@index([companyName])
  @@index([status])
  @@map("suppliers")
}

// ---------------------------------------------------------------------------
// Documents (SOW §6, §11, §13, §16) — one engine, not eight
// ---------------------------------------------------------------------------

/// What a document can belong to. Vehicles, contracts and policies arrive in
/// 1B and 1D; the enum carries them now so adding those models needs no
/// migration of this one.
enum DocumentOwnerType {
  CUSTOMER
  SUPPLIER
  VEHICLE
  CONTRACT
  INSURANCE_POLICY
  MAINTENANCE
  HANDOVER
  DAMAGE_POINT

  @@map("document_owner_type")
}

enum DocumentStatus {
  VALID
  EXPIRING
  EXPIRED
  REPLACED

  @@map("document_status")
}

/// Configurable per §17: the client adds a document type without a release.
model DocumentCategory {
  id    String @id @default(cuid())
  key   String @unique
  label String

  /// Which owners this category may be attached to, so the upload form offers
  /// passport for a customer and trade licence for a supplier.
  appliesTo DocumentOwnerType[] @map("applies_to")

  requiresExpiry         Boolean @default(true) @map("requires_expiry")
  /// Days before expiry to warn, per §6. Overridable per document.
  defaultReminderOffsets Int[]   @default([60, 30, 15, 7]) @map("default_reminder_offsets")

  /// Seeded categories are protected from deletion, not from editing.
  isSystem Boolean @default(false) @map("is_system")

  documents Document[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("document_categories")
}

/// Polymorphic on purpose (PROJECT_PLAN.md §3.3): Emirates ID, licence,
/// passport, visa, trade licence, mulkiya, policy and signed contract are all
/// the same shape, and one expiry job covers every one of them.
///
/// The cost is no foreign key on the owner — the database cannot stop a row
/// pointing at a deleted customer. Deletions go through the application, which
/// removes documents with their owner, and (ownerType, ownerId) is indexed so
/// an orphan check is cheap to run.
model Document {
  id         String            @id @default(cuid())
  ownerType  DocumentOwnerType @map("owner_type")
  ownerId    String            @map("owner_id")
  categoryId String            @map("category_id")
  category   DocumentCategory  @relation(fields: [categoryId], references: [id])

  documentNumber String?   @map("document_number")
  issueDate      DateTime? @map("issue_date")
  expiryDate     DateTime? @map("expiry_date")

  /// Key in object storage. The original filename is kept separately: it is the
  /// user's text and must never become part of a storage path.
  fileKey   String @map("file_key")
  fileName  String @map("file_name")
  mimeType  String @map("mime_type")
  sizeBytes Int    @map("size_bytes")

  status          DocumentStatus @default(VALID)
  reminderOffsets Int[]          @map("reminder_offsets")
  notes           String?

  /// Set when a newer document replaces this one, so history is kept rather
  /// than overwritten.
  replacedById String?   @map("replaced_by_id")
  replacedAt   DateTime? @map("replaced_at")

  uploadedById String? @map("uploaded_by_id")
  uploadedBy   User?   @relation(fields: [uploadedById], references: [id], onDelete: SetNull)

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([ownerType, ownerId])
  // Drives the nightly expiry scan, which reads by date across every owner type.
  @@index([expiryDate, status])
  @@index([documentNumber])
  @@map("documents")
}

// ---------------------------------------------------------------------------
// Notifications (SOW §16)
// ---------------------------------------------------------------------------

enum NotificationType {
  DOCUMENT_EXPIRY
  INSURANCE_EXPIRY
  PAYMENT_DUE
  PAYMENT_OVERDUE
  CONTRACT_EXPIRY
  MAINTENANCE_DUE
  SUPPLIER_PAYMENT_DUE

  @@map("notification_type")
}

enum NotificationSeverity {
  INFO
  WARNING
  CRITICAL

  @@map("notification_severity")
}

model Notification {
  id       String               @id @default(cuid())
  type     NotificationType
  severity NotificationSeverity @default(INFO)

  title String
  body  String

  entityType String    @map("entity_type")
  entityId   String    @map("entity_id")
  dueOn      DateTime? @map("due_on")

  /// Null means everyone who holds the relevant permission sees it.
  userId String? @map("user_id")
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  readAt DateTime? @map("read_at")

  /// The nightly scan runs every day and would otherwise raise the same warning
  /// every day. One key per document per reminder offset makes a repeat run a
  /// no-op, which is what keeps the notification list worth reading.
  dedupeKey String @unique @map("dedupe_key")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId, readAt])
  @@index([type, dueOn])
  @@map("notifications")
}

// ===========================================================================
// Milestone 1B — Fleet (SOW §4)
// ===========================================================================

enum OwnershipType {
  /// Bought by DrivenX; the purchase price is its cost.
  COMPANY_OWNED
  /// Leased in from a supplier; the monthly cost to that supplier is its cost.
  B2B_SUPPLIER

  @@map("ownership_type")
}

/// Transitions between these are governed by @drivenx/core fleet/status.ts, never set freely.
enum VehicleStatus {
  AVAILABLE
  RESERVED
  RENTED
  LEASE_TO_OWN
  MAINTENANCE
  ACCIDENT
  RETURNED
  SOLD
  INACTIVE

  @@map("vehicle_status")
}

/// Plates are issued per emirate: "A 12345" in Dubai and in Abu Dhabi are different cars.
enum Emirate {
  ABU_DHABI
  DUBAI
  SHARJAH
  AJMAN
  UMM_AL_QUWAIN
  RAS_AL_KHAIMAH
  FUJAIRAH

  @@map("emirate")
}

model Vehicle {
  id   String @id @default(cuid())
  /// Human-facing fleet number, VEH-00001, from a sequence like party codes.
  code String @unique

  make    String
  model   String
  year    Int
  variant String?
  colour  String?

  plateEmirate Emirate @default(DUBAI) @map("plate_emirate")
  /// The letter or number category printed beside the number.
  plateCode    String  @map("plate_code")
  plateNumber  String  @map("plate_number")
  vin          String  @unique

  /// Always the highest recorded reading; see MileageReading.
  currentMileageKm Int @default(0) @map("current_mileage_km")

  ownershipType OwnershipType @map("ownership_type")
  /// Required when B2B_SUPPLIER — enforced by a CHECK constraint, not only by the form.
  supplierId    String?       @map("supplier_id")
  supplier      Supplier?     @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  sourceDate    DateTime?     @map("source_date")

  purchasePriceFils       BigInt? @map("purchase_price_fils")
  supplierMonthlyCostFils BigInt? @map("supplier_monthly_cost_fils")

  status VehicleStatus @default(AVAILABLE)
  notes  String?

  statusChanges     VehicleStatusChange[]
  mileageReadings   MileageReading[]
  contracts         Contract[]
  supplierInvoices  SupplierInvoice[]
  interestedLeads   Lead[]
  leadQuotes        LeadQuote[]
  insurancePolicies InsurancePolicy[]
  maintenance       MaintenanceRecord[]
  handovers         Handover[]

  createdById String? @map("created_by_id")
  createdBy   User?   @relation(fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@unique([plateEmirate, plateCode, plateNumber])
  @@index([status, ownershipType])
  @@index([supplierId])
  @@index([make, model])
  @@map("vehicles")
}

/// Every status a vehicle has held, for the detail page's timeline (P1B-07).
model VehicleStatusChange {
  id         String         @id @default(cuid())
  vehicleId  String         @map("vehicle_id")
  vehicle    Vehicle        @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  /// Null on the entry that records the vehicle joining the fleet.
  fromStatus VehicleStatus? @map("from_status")
  toStatus   VehicleStatus  @map("to_status")
  reason     String?

  changedById String?  @map("changed_by_id")
  changedBy   User?    @relation(fields: [changedById], references: [id], onDelete: SetNull)
  changedAt   DateTime @default(now()) @map("changed_at")

  @@index([vehicleId, changedAt])
  @@map("vehicle_status_changes")
}

/// Odometer readings (P1B-08). Monotonic: see @drivenx/core fleet/mileage.ts.
model MileageReading {
  id        String   @id @default(cuid())
  vehicleId String   @map("vehicle_id")
  vehicle   Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  readingKm Int      @map("reading_km")
  readAt    DateTime @default(now()) @map("read_at")
  note      String?

  recordedById String?  @map("recorded_by_id")
  recordedBy   User?    @relation(fields: [recordedById], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([vehicleId, readAt])
  @@map("mileage_readings")
}

// ===========================================================================
// Milestone 1D — Contracts, payments and the ledger (SOW §9, §10, §11)
// ===========================================================================

enum ContractType {
  LONG_TERM_RENTAL
  LEASE_TO_OWN
  B2B_RENTAL
  OTHER

  @@map("contract_type")
}

/// Transitions governed by @drivenx/core contracts/status.ts.
enum ContractStatus {
  DRAFT
  PENDING
  ACTIVE
  OVERDUE
  COMPLETED
  CANCELLED

  @@map("contract_status")
}

enum ChargeType {
  MONTHLY_RENTAL
  ANNUAL_INSURANCE
  DOWN_PAYMENT
  ADMIN_FEE
  BUYOUT
  OTHER

  @@map("charge_type")
}

enum Recurrence {
  ONCE
  MONTHLY
  ANNUAL

  @@map("recurrence")
}

enum InstallmentStatus {
  UPCOMING
  DUE
  PARTIALLY_PAID
  PAID
  OVERDUE
  WAIVED
  /// The contract ended before this month fell due, so it was never invoiced.
  CANCELLED

  @@map("installment_status")
}

/// How money moves (client, 2026-09-20). Cheques are not used, so there is no
/// post-dated cheque tracking; Tamara and Tabby are the buy-now-pay-later providers.
enum PaymentMethod {
  CASH
  BANK_TRANSFER
  CARD
  TAMARA
  TABBY
  OTHER

  @@map("payment_method")
}

enum LedgerDirection {
  REVENUE
  COST

  @@map("ledger_direction")
}

model Contract {
  id     String @id @default(cuid())
  /// CON-00001, from a sequence like other record codes.
  number String @unique

  customerId String    @map("customer_id")
  customer   Customer  @relation(fields: [customerId], references: [id], onDelete: Restrict)
  vehicleId  String    @map("vehicle_id")
  vehicle    Vehicle   @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  /// The vehicle's supplier when the contract was written, kept so supplier reports
  /// still attribute it after the vehicle's own record changes.
  supplierId String?   @map("supplier_id")
  supplier   Supplier? @relation(fields: [supplierId], references: [id], onDelete: Restrict)

  type   ContractType
  status ContractStatus @default(DRAFT)

  startDate      DateTime @map("start_date") @db.Date
  endDate        DateTime @map("end_date") @db.Date
  durationMonths Int      @map("duration_months")

  /// All net of VAT (client, 2026-09-17). The schedule is expanded from these at activation.
  monthlyRentalFils   BigInt @map("monthly_rental_fils")
  downPaymentFils     BigInt @default(0) @map("down_payment_fils")
  buyoutFils          BigInt @default(0) @map("buyout_fils")
  annualInsuranceFils BigInt @default(0) @map("annual_insurance_fils")
  /// The rate the contract was written at; each instalment also stores its own (INV-10).
  vatBasisPoints      Int    @default(500) @map("vat_basis_points")

  mileageAllowanceKm    Int?    @map("mileage_allowance_km")
  excessMileageRateFils BigInt? @map("excess_mileage_rate_fils")
  terms                 String?

  activatedAt  DateTime? @map("activated_at")
  cancelReason String?   @map("cancel_reason")

  charges          ContractCharge[]
  installments     Installment[]
  payments         Payment[]
  statusChanges    ContractStatusChange[]
  supplierInvoices SupplierInvoice[]
  handovers        Handover[]
  settlement       Settlement?
  maintenance      MaintenanceRecord[]

  /// The lead it was converted from, if any, and who is credited with the sale (P1F-04).
  /// Set from the lead on conversion; a contract written directly credits its author.
  leadId        String? @unique @map("lead_id")
  lead          Lead?   @relation(fields: [leadId], references: [id], onDelete: SetNull)
  salespersonId String? @map("salesperson_id")
  salesperson   User?   @relation("ContractSalesperson", fields: [salespersonId], references: [id], onDelete: SetNull)

  createdById String? @map("created_by_id")
  createdBy   User?   @relation("ContractCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([status, endDate])
  @@index([vehicleId, status])
  @@index([customerId])
  @@map("contracts")
}

/// One composable charge (§3.4). Rental, insurance, down payment, buyout and fees are each
/// a row, so contract types differ only in which charges they carry.
model ContractCharge {
  id             String     @id @default(cuid())
  contractId     String     @map("contract_id")
  contract       Contract   @relation(fields: [contractId], references: [id], onDelete: Restrict)
  key            String
  chargeType     ChargeType @map("charge_type")
  label          String
  recurrence     Recurrence
  amountFils     BigInt     @map("amount_fils")
  startsOn       DateTime   @map("starts_on") @db.Date
  occurrences    Int
  vatBasisPoints Int        @map("vat_basis_points")

  installments Installment[]

  @@unique([contractId, key])
  @@map("contract_charges")
}

model Installment {
  id         String         @id @default(cuid())
  contractId String         @map("contract_id")
  contract   Contract       @relation(fields: [contractId], references: [id], onDelete: Restrict)
  chargeId   String         @map("charge_id")
  charge     ContractCharge @relation(fields: [chargeId], references: [id], onDelete: Restrict)
  sequence   Int

  periodStart DateTime @map("period_start") @db.Date
  periodEnd   DateTime @map("period_end") @db.Date
  dueDate     DateTime @map("due_date") @db.Date

  /// INV-10: gross = net + VAT, at the rate stored here, so a later rate change cannot
  /// rewrite an invoice already issued.
  netFils        BigInt @map("net_fils")
  vatBasisPoints Int    @map("vat_basis_points")
  vatFils        BigInt @map("vat_fils")
  grossFils      BigInt @map("gross_fils")
  /// INV-3: always the sum of this instalment's allocations, never above gross.
  paidFils       BigInt @default(0) @map("paid_fils")

  status InstallmentStatus @default(UPCOMING)

  /// Assigned when it falls due and is issued — gapless, from InvoiceCounter.
  invoiceNumber String?   @unique @map("invoice_number")
  issuedOn      DateTime? @map("issued_on") @db.Date

  waivedAt    DateTime? @map("waived_at")
  waiveReason String?   @map("waive_reason")
  waivedById  String?   @map("waived_by_id")
  waivedBy    User?     @relation(fields: [waivedById], references: [id], onDelete: SetNull)

  allocations PaymentAllocation[]
  settlement  Settlement?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([chargeId, sequence])
  @@index([dueDate, status])
  @@index([contractId, dueDate])
  @@map("installments")
}

model Payment {
  id         String        @id @default(cuid())
  contractId String        @map("contract_id")
  contract   Contract      @relation(fields: [contractId], references: [id], onDelete: Restrict)
  customerId String        @map("customer_id")
  customer   Customer      @relation(fields: [customerId], references: [id], onDelete: Restrict)
  receivedOn DateTime      @map("received_on") @db.Date
  /// Gross — what the customer actually handed over.
  amountFils BigInt        @map("amount_fils")
  method     PaymentMethod
  reference  String?
  notes      String?
  /// INV-2: allocations plus this are exactly the payment. Nothing paid is ever dropped.
  creditFils BigInt        @default(0) @map("credit_fils")

  allocations PaymentAllocation[]

  recordedById String?  @map("recorded_by_id")
  recordedBy   User?    @relation(fields: [recordedById], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([contractId, receivedOn])
  @@index([customerId])
  @@map("payments")
}

model PaymentAllocation {
  id            String      @id @default(cuid())
  paymentId     String      @map("payment_id")
  payment       Payment     @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  installmentId String      @map("installment_id")
  installment   Installment @relation(fields: [installmentId], references: [id], onDelete: Restrict)
  amountFils    BigInt      @map("amount_fils")
  createdAt     DateTime    @default(now()) @map("created_at")

  @@index([installmentId])
  @@index([paymentId])
  @@map("payment_allocations")
}

enum SupplierInvoiceStatus {
  UPCOMING
  DUE
  PARTIALLY_PAID
  PAID
  OVERDUE

  @@map("supplier_invoice_status")
}

/// What DrivenX owes the supplier of a leased-in car for one contract month (P1D-13).
/// Written at activation, beside the customer's schedule. The cost is recognised when it
/// falls due (raisedOn), as revenue is when an instalment is issued.
model SupplierInvoice {
  id         String   @id @default(cuid())
  supplierId String   @map("supplier_id")
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  vehicleId  String   @map("vehicle_id")
  vehicle    Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  contractId String   @map("contract_id")
  contract   Contract @relation(fields: [contractId], references: [id], onDelete: Restrict)
  sequence   Int

  periodStart DateTime @map("period_start") @db.Date
  periodEnd   DateTime @map("period_end") @db.Date
  dueDate     DateTime @map("due_date") @db.Date

  /// The monthly cost agreed with the supplier, copied from the vehicle at activation.
  /// Net: the supplier adds VAT on top, and that VAT is recoverable (client, 2026-09-20),
  /// so it is never cost. The ledger takes the net figure; the supplier is paid the gross.
  netFils        BigInt @map("net_fils")
  vatBasisPoints Int    @default(500) @map("vat_basis_points")
  vatFils        BigInt @map("vat_fils")
  grossFils      BigInt @map("gross_fils")
  /// Always the sum of this invoice's payments, never above the gross.
  paidFils       BigInt @default(0) @map("paid_fils")

  status            SupplierInvoiceStatus @default(UPCOMING)
  /// The day the cost was posted to the ledger. Null until it falls due.
  raisedOn          DateTime?             @map("raised_on") @db.Date
  /// The supplier's own invoice number, once their paper arrives.
  supplierReference String?               @map("supplier_reference")

  payments SupplierPayment[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([contractId, sequence])
  @@index([supplierId, dueDate])
  @@index([dueDate, status])
  @@map("supplier_invoices")
}

/// Money paid out to a supplier against one invoice. Cash only: the cost was booked when
/// the invoice fell due, so paying it never touches the ledger.
model SupplierPayment {
  id                String          @id @default(cuid())
  supplierInvoiceId String          @map("supplier_invoice_id")
  supplierInvoice   SupplierInvoice @relation(fields: [supplierInvoiceId], references: [id], onDelete: Restrict)
  supplierId        String          @map("supplier_id")
  supplier          Supplier        @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  paidOn            DateTime        @map("paid_on") @db.Date
  amountFils        BigInt          @map("amount_fils")
  method            PaymentMethod
  reference         String?

  recordedById String?  @map("recorded_by_id")
  recordedBy   User?    @relation(fields: [recordedById], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([supplierInvoiceId])
  @@index([supplierId, paidOn])
  @@map("supplier_payments")
}

/// The single source of financial truth (§3.2). Append-only, enforced by a trigger:
/// corrections are reversing entries, never an UPDATE or DELETE (INV-7).
model LedgerEntry {
  id          String          @id @default(cuid())
  occurredOn  DateTime        @map("occurred_on") @db.Date
  /// YYYYMM — every report groups on it.
  periodMonth Int             @map("period_month")
  direction   LedgerDirection
  /// revenue.rental | revenue.insurance | revenue.other | cost.supplier | cost.insurance | …
  category    String
  amountFils  BigInt          @map("amount_fils")

  vehicleId  String? @map("vehicle_id")
  contractId String? @map("contract_id")
  customerId String? @map("customer_id")
  supplierId String? @map("supplier_id")

  /// What produced the entry. With the category, unique: posting the same event twice is
  /// a no-op rather than double revenue.
  sourceType String  @map("source_type")
  sourceId   String  @map("source_id")
  reversesId String? @map("reverses_id")
  memo       String?

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([sourceType, sourceId, category])
  @@index([periodMonth, direction, category])
  @@index([vehicleId, periodMonth])
  @@index([contractId])
  @@index([supplierId, periodMonth])
  @@map("ledger_entries")
}

/// Gapless numbering for tax invoices (P1D-05). A sequence can skip numbers; a counter row
/// incremented under a lock cannot.
model InvoiceCounter {
  id   String @id
  next BigInt @default(1)

  @@map("invoice_counters")
}

model ContractStatusChange {
  id          String          @id @default(cuid())
  contractId  String          @map("contract_id")
  contract    Contract        @relation(fields: [contractId], references: [id], onDelete: Restrict)
  fromStatus  ContractStatus? @map("from_status")
  toStatus    ContractStatus  @map("to_status")
  reason      String?
  changedById String?         @map("changed_by_id")
  changedBy   User?           @relation(fields: [changedById], references: [id], onDelete: SetNull)
  changedAt   DateTime        @default(now()) @map("changed_at")

  @@index([contractId, changedAt])
  @@map("contract_status_changes")
}

// ===========================================================================
// Leads (milestone 1F, SOW §7)
// ===========================================================================

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  DEAL_CREATED
  CONTRACTED
  LOST

  @@map("lead_status")
}

enum LeadSource {
  WALK_IN
  PHONE
  WHATSAPP
  WEBSITE
  SOCIAL
  REFERRAL
  OTHER

  @@map("lead_source")
}

/// Someone who might rent or buy (P1F-01). Owned by a salesperson: Sales Staff see only
/// their own (P1F-05).
model Lead {
  id     String     @id @default(cuid())
  /// LEAD-00001, from a sequence like other record codes.
  code   String     @unique
  status LeadStatus @default(NEW)

  name   String
  mobile String
  email  String?
  source LeadSource @default(OTHER)

  interestedVehicleId String?  @map("interested_vehicle_id")
  interestedVehicle   Vehicle? @relation(fields: [interestedVehicleId], references: [id], onDelete: SetNull)
  /// What they said they can pay a month, net of VAT.
  budgetFils          BigInt?  @map("budget_fils")
  durationMonths      Int?     @map("duration_months")
  notes               String?

  salespersonId String? @map("salesperson_id")
  salesperson   User?   @relation("LeadSalesperson", fields: [salespersonId], references: [id], onDelete: SetNull)

  lostReason String?   @map("lost_reason")
  /// The customer record it became, matched on mobile or created at conversion.
  customerId String?   @map("customer_id")
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  contract   Contract?

  quotes        LeadQuote[]
  statusChanges LeadStatusChange[]

  createdById String?   @map("created_by_id")
  createdBy   User?     @relation("LeadCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  @@index([salespersonId, status])
  @@index([status])
  @@index([mobile])
  @@map("leads")
}

/// A priced deal for a lead, from the deal calculator (P1F-04). Kept, not overwritten:
/// the latest is what converts, the earlier ones show how the price moved.
model LeadQuote {
  id        String       @id @default(cuid())
  leadId    String       @map("lead_id")
  lead      Lead         @relation(fields: [leadId], references: [id], onDelete: Cascade)
  vehicleId String       @map("vehicle_id")
  vehicle   Vehicle      @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  type      ContractType

  durationMonths      Int    @map("duration_months")
  /// All net of VAT, as the calculator and contracts take them.
  monthlyRentalFils   BigInt @map("monthly_rental_fils")
  downPaymentFils     BigInt @default(0) @map("down_payment_fils")
  annualInsuranceFils BigInt @default(0) @map("annual_insurance_fils")
  buyoutFils          BigInt @default(0) @map("buyout_fils")

  createdById String?  @map("created_by_id")
  createdBy   User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([leadId, createdAt])
  @@map("lead_quotes")
}

model LeadStatusChange {
  id          String      @id @default(cuid())
  leadId      String      @map("lead_id")
  lead        Lead        @relation(fields: [leadId], references: [id], onDelete: Cascade)
  fromStatus  LeadStatus? @map("from_status")
  toStatus    LeadStatus  @map("to_status")
  note        String?
  changedById String?     @map("changed_by_id")
  changedBy   User?       @relation(fields: [changedById], references: [id], onDelete: SetNull)
  changedAt   DateTime    @default(now()) @map("changed_at")

  @@index([leadId, changedAt])
  @@map("lead_status_changes")
}

// ===========================================================================
// Insurance (P1D-10 – P1D-12, SOW §11)
// ===========================================================================

enum InsuranceCoverage {
  COMPREHENSIVE
  THIRD_PARTY

  @@map("insurance_coverage")
}

/// A policy on one car: what the insurer charges DrivenX, against what DrivenX charges
/// the customer for insurance on the contract.
///
/// The premium is the insurer's invoice (client, 2026-09-20). It is held net, with its
/// VAT beside it, because that VAT is recoverable and is not a cost — the same rule as
/// supplier invoices. The cost is posted to the ledger on the day cover starts, which is
/// when the insurer invoices it.
model InsurancePolicy {
  id        String  @id @default(cuid())
  vehicleId String  @map("vehicle_id")
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Restrict)

  provider     String
  policyNumber String            @map("policy_number")
  coverage     InsuranceCoverage @default(COMPREHENSIVE)

  startDate  DateTime @map("start_date") @db.Date
  expiryDate DateTime @map("expiry_date") @db.Date

  premiumNetFils BigInt @map("premium_net_fils")
  vatBasisPoints Int    @default(500) @map("vat_basis_points")
  premiumVatFils BigInt @map("premium_vat_fils")
  /// What DrivenX actually pays the insurer.
  premiumFils    BigInt @map("premium_fils")

  /// Cancelled before its expiry; the cover no longer stands whatever the dates say.
  cancelledAt  DateTime? @map("cancelled_at")
  cancelReason String?   @map("cancel_reason")
  /// What the insurer refunded on cancellation, if anything — posted as a reversal.
  refundFils   BigInt?   @map("refund_fils")

  notes String?

  createdById String?   @map("created_by_id")
  createdBy   User?     @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  @@unique([provider, policyNumber])
  @@index([vehicleId, expiryDate])
  @@index([expiryDate])
  @@map("insurance_policies")
}

// ===========================================================================
// Settlement (client 2026-09-20; P2-12)
// ===========================================================================

enum SettlementReason {
  /// The customer stopped early. Settled case by case (client, 2026-09-20).
  EARLY_TERMINATION
  /// The term ran out and the car came back.
  END_OF_TERM
  /// Returned mid-term by agreement.
  RETURN

  @@map("settlement_reason")
}

enum SettlementStatus {
  OPEN
  SETTLED
  VOID

  @@map("settlement_status")
}

enum SettlementLineKind {
  /// Something more to pay: excess mileage, damage, a fee.
  CHARGE
  /// Something taken off: goodwill, a discount agreed on the day.
  CREDIT

  @@map("settlement_line_kind")
}

enum SettlementChargeType {
  EXCESS_MILEAGE
  DAMAGE
  FEE
  OTHER

  @@map("settlement_charge_type")
}

/// The reckoning when a contract ends (client, 2026-09-20; P2-12).
///
/// Arrears are not lines here: instalments already invoiced are already revenue and
/// already owed, and charging them again would count them twice. They are shown beside
/// the settlement, live. What this holds is what is new — excess mileage, damage, fees —
/// and what is taken off, which together become one final invoice when it is settled.
model Settlement {
  id         String           @id @default(cuid())
  contractId String           @unique @map("contract_id")
  contract   Contract         @relation(fields: [contractId], references: [id], onDelete: Restrict)
  reason     SettlementReason
  status     SettlementStatus @default(OPEN)

  /// Mileage on the day the car came back, for the excess-mileage line staff work out.
  returnedMileageKm Int?    @map("returned_mileage_km")
  notes             String?

  /// The instalment the settled total was invoiced as, when there was anything to pay.
  installmentId String?      @unique @map("installment_id")
  installment   Installment? @relation(fields: [installmentId], references: [id], onDelete: SetNull)

  lines SettlementLine[]

  openedById  String?   @map("opened_by_id")
  openedBy    User?     @relation("SettlementOpenedBy", fields: [openedById], references: [id], onDelete: SetNull)
  openedAt    DateTime  @default(now()) @map("opened_at")
  settledById String?   @map("settled_by_id")
  settledBy   User?     @relation("SettlementSettledBy", fields: [settledById], references: [id], onDelete: SetNull)
  settledOn   DateTime? @map("settled_on") @db.Date

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([status])
  @@map("settlements")
}

model SettlementLine {
  id           String               @id @default(cuid())
  settlementId String               @map("settlement_id")
  settlement   Settlement           @relation(fields: [settlementId], references: [id], onDelete: Cascade)
  kind         SettlementLineKind
  chargeType   SettlementChargeType @default(OTHER) @map("charge_type")
  label        String

  /// Net, like every contract amount; VAT is added at the rate stored here.
  netFils        BigInt @map("net_fils")
  vatBasisPoints Int    @default(500) @map("vat_basis_points")
  vatFils        BigInt @map("vat_fils")
  grossFils      BigInt @map("gross_fils")

  createdById String?  @map("created_by_id")
  createdBy   User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([settlementId])
  @@map("settlement_lines")
}

// ===========================================================================
// Maintenance (P2-05, P2-06, SOW §12)
// ===========================================================================

enum MaintenanceType {
  SERVICE
  REPAIR
  TYRES
  INSPECTION
  BODYWORK
  OTHER

  @@map("maintenance_type")
}

/// What keeping a car on the road cost, and when it is next due (P2-05).
///
/// The bill is held net with its VAT beside it, because input VAT is recoverable (client,
/// 2026-09-20) and is never cost — the same rule as supplier invoices and insurance. The
/// net is posted to `cost.maintenance` on the day of the work, against the car and, when
/// it was out on contract that day, against the contract too, so vehicle and contract
/// profitability both carry it.
model MaintenanceRecord {
  id        String          @id @default(cuid())
  vehicleId String          @map("vehicle_id")
  vehicle   Vehicle         @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  type      MaintenanceType @default(SERVICE)

  servicedOn DateTime @map("serviced_on") @db.Date
  /// The odometer at the garage, which is also recorded as a mileage reading.
  odometerKm Int      @map("odometer_km")

  vendor              String
  vendorInvoiceNumber String? @map("vendor_invoice_number")
  description         String?

  costNetFils    BigInt @map("cost_net_fils")
  vatBasisPoints Int    @default(500) @map("vat_basis_points")
  costVatFils    BigInt @map("cost_vat_fils")
  /// What was actually paid to the garage.
  costFils       BigInt @map("cost_fils")

  /// When the next service is due, by date, by distance, or both.
  nextServiceOn DateTime? @map("next_service_on") @db.Date
  nextServiceKm Int?      @map("next_service_km")

  /// The contract the car was out on that day, when it was out on one.
  contractId String?   @map("contract_id")
  contract   Contract? @relation(fields: [contractId], references: [id], onDelete: SetNull)

  notes String?

  createdById String?   @map("created_by_id")
  createdBy   User?     @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  @@index([vehicleId, servicedOn])
  @@index([nextServiceOn])
  @@index([nextServiceKm])
  @@map("maintenance_records")
}

// ===========================================================================
// Handover & return (P2-01 – P2-04, SOW §12)
// ===========================================================================

enum HandoverType {
  /// The car going out to the customer.
  HANDOVER
  /// The car coming back.
  RETURN

  @@map("handover_type")
}

enum HandoverStatus {
  /// Being filled in at the counter, with the car and the customer present.
  DRAFT
  /// Both signatures taken. The readings are evidence now, so they stop being editable.
  SIGNED

  @@map("handover_status")
}

enum VehiclePanel {
  FRONT_BUMPER
  BONNET
  WINDSCREEN
  ROOF
  REAR_SCREEN
  BOOT
  REAR_BUMPER
  FRONT_LEFT_WING
  FRONT_LEFT_DOOR
  REAR_LEFT_DOOR
  REAR_LEFT_WING
  FRONT_RIGHT_WING
  FRONT_RIGHT_DOOR
  REAR_RIGHT_DOOR
  REAR_RIGHT_WING
  WHEELS
  INTERIOR
  MECHANICAL
  OTHER

  @@map("vehicle_panel")
}

enum DamageSeverity {
  MINOR
  MODERATE
  SEVERE

  @@map("damage_severity")
}

/// The condition of a car as it changed hands (P2-01, SOW §12).
///
/// Handing a car over and taking it back are the same form read in two directions, so
/// they are one model with a direction rather than two. That is what lets the return be
/// laid against the handover field for field — and the difference between them is exactly
/// what the final settlement charges for, so it has to be demonstrable rather than
/// asserted.
///
/// One of each per contract. A car swapped mid-term is a change of vehicle the system
/// does not model, and quietly allowing a second handover would hide that rather than
/// surface it.
model Handover {
  id         String       @id @default(cuid())
  contractId String       @map("contract_id")
  contract   Contract     @relation(fields: [contractId], references: [id], onDelete: Restrict)
  /// Denormalised from the contract so fleet queries need no join, and so the record
  /// still names the right car if the contract is ever pointed at another one.
  vehicleId  String       @map("vehicle_id")
  vehicle    Vehicle      @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  type       HandoverType

  status HandoverStatus @default(DRAFT)

  /// A timestamp, not a date: which of two cars went out first on a busy morning is a
  /// question the handover form is expected to answer.
  occurredAt DateTime @map("occurred_at")

  /// Also recorded as a mileage reading, like the odometer at a garage.
  odometerKm  Int @map("odometer_km")
  /// Off the gauge, in eighths of a tank. See core/fleet/handover.ts.
  fuelEighths Int @map("fuel_eighths")

  /// Everything that is not a mark on the diagram: a warning light, a missing spare.
  conditionNotes String? @map("condition_notes")

  /// Signatures live in object storage like any other file, and the name is captured
  /// beside them: a signature is a scrawl, and the name is what makes it legible.
  customerSignatureKey  String?   @map("customer_signature_key")
  customerSignatureName String?   @map("customer_signature_name")
  customerSignedAt      DateTime? @map("customer_signed_at")
  staffSignatureKey     String?   @map("staff_signature_key")
  staffSignatureName    String?   @map("staff_signature_name")
  staffSignedAt         DateTime? @map("staff_signed_at")

  damagePoints DamagePoint[]

  recordedById String?   @map("recorded_by_id")
  recordedBy   User?     @relation(fields: [recordedById], references: [id], onDelete: SetNull)
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")

  /// One of each per contract, but only among the forms that still stand: a draft that
  /// was thrown away must free its slot, and a plain unique index would hold it for ever.
  /// Enforced by a partial unique index in the migration, which Prisma cannot express.
  @@index([contractId, type])
  @@index([vehicleId, occurredAt])
  @@index([status])
  @@map("handovers")
}

/// One mark on the car (P2-02).
///
/// The position is a fraction of the diagram box rather than a pixel, so the same mark
/// draws correctly on a phone at the kerbside and on the A4 report afterwards. Panels the
/// diagram cannot show — interior, wheels, mechanical — carry no position at all, because
/// putting them somewhere on the outline would make the picture lie.
model DamagePoint {
  id         String         @id @default(cuid())
  handoverId String         @map("handover_id")
  handover   Handover       @relation(fields: [handoverId], references: [id], onDelete: Cascade)
  panel      VehiclePanel
  severity   DamageSeverity @default(MINOR)

  positionX Float? @map("position_x")
  positionY Float? @map("position_y")

  note String?

  /// Photographs hang off this row through the document engine, owner type DAMAGE_POINT.
  createdById String?  @map("created_by_id")
  createdBy   User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([handoverId])
  @@map("damage_points")
}
