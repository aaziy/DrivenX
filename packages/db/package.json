{
  "name": "@drivenx/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Prisma schema, migrations and client for DrivenX",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "generate": "prisma generate",
    "migrate": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "reset": "prisma migrate reset --force",
    "seed": "tsx prisma/seed.ts",
    "studio": "prisma studio",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@prisma/client": "catalog:"
  },
  "devDependencies": {
    "@drivenx/auth": "workspace:*",
    "prisma": "catalog:",
    "tsx": "^4.20.6",
    "typescript": "catalog:"
  },
  "prisma": {
    "schema": "prisma/schema.prisma"
  }
}
