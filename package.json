{
  "name": "drivenx",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "DrivenX — Vehicle Rental & Lease-to-Own Management System",
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @drivenx/web dev",
    "build": "pnpm -r --filter=!@drivenx/e2e build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:reconciliation": "vitest run --project reconciliation",
    "test:e2e": "playwright test",
    "test:coverage": "vitest run --coverage",
    "db:generate": "prisma generate --schema packages/db/prisma/schema.prisma",
    "db:migrate": "prisma migrate dev --schema packages/db/prisma/schema.prisma",
    "db:migrate:deploy": "prisma migrate deploy --schema packages/db/prisma/schema.prisma",
    "db:migrate:test": "node scripts/migrate-test-db.mjs",
    "db:reset": "prisma migrate reset --force --schema packages/db/prisma/schema.prisma",
    "db:seed": "tsx packages/db/prisma/seed.ts",
    "db:studio": "prisma studio --schema packages/db/prisma/schema.prisma",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:reset": "docker compose down -v && docker compose up -d",
    "verify": "pnpm db:generate && pnpm lint && pnpm typecheck && pnpm db:migrate:test && pnpm test"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "eslint": "catalog:",
    "prettier": "catalog:",
    "prisma": "catalog:",
    "tsx": "^4.20.6",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "vitest": "catalog:"
  }
}
